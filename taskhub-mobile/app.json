{
  "expo": {
    "name": "TaskHub",
    "slug": "taskhub-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "plugins": [
      "@react-native-google-signin/google-signin",
      "expo-asset"
    ],
    "android": {
      "package": "com.taskhub.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.taskhub.mobile"
    },
    "extra": {
      "eas": {
        "projectId": "34c9a044-ca60-47fb-a20e-55e29be68d31"
      }
    }
  }
}
