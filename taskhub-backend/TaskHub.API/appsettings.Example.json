{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "MongoDbSettings": {
    "ConnectionString": "mongodb+srv://<user>:<password>@<cluster>/TaskHubDB?appName=Cluster0",
    "DatabaseName": "TaskHubDB"
  },
  "Jwt": {
    "Secret": "<at-least-32-char-random-secret>",
    "Issuer": "TaskHubAPI",
    "Audience": "TaskHubUsers",
    "ExpiryInMinutes": 60
  },
  "Google": {
    "ClientId": "<google-oauth-client-id>"
  },
  "EmailSettings": {
    "SenderName": "TaskHub Support",
    "SenderEmail": "<verified-sender@example.com>",
    "BrevoApiKey": "<brevo-v3-api-key>"
  },
  "PayOS": {
    "ClientId": "<payos-client-id>",
    "ApiKey": "<payos-api-key>",
    "ChecksumKey": "<payos-checksum-key>"
  }
}
